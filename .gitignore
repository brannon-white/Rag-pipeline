# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.python-version

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Data / index artifacts (regenerable; never in git) ---
data/
*.jsonl.gz
.checkpoints/
corpus_cache/
embeddings_cache/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
crash.log

# --- Load test output ---
loadtest/results/*.json
!loadtest/results/.gitkeep

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Node (frontend tooling, if added) ---
node_modules/
