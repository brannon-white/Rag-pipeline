# ---------------------------------------------------------------------------
# TrialRAG configuration. Copy to `.env` and fill in.
# Every var here maps 1:1 to a field on `trialrag.config.Settings`.
# In AWS these come from Secrets Manager / SSM, never from a file.
# ---------------------------------------------------------------------------

# --- Environment ---
TRIALRAG_ENV=local                       # local | ci | staging | prod
TRIALRAG_LOG_LEVEL=INFO
TRIALRAG_LOG_FORMAT=console              # console | json  (json in deployed envs)

# --- Database ---
# Local docker-compose default; in prod this is the Neon pooled connection string.
TRIALRAG_DATABASE_URL=postgresql://trialrag:trialrag@localhost:5432/trialrag
TRIALRAG_DB_POOL_MIN_SIZE=0              # 0 lets Neon scale-to-zero when idle
TRIALRAG_DB_POOL_MAX_SIZE=10
TRIALRAG_DB_IDLE_TIMEOUT_S=240           # < Neon's 300s suspend window

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
TRIALRAG_ANSWER_MODEL=claude-opus-5
TRIALRAG_ANSWER_EFFORT=low               # low | medium | high | xhigh | max
TRIALRAG_QUERY_PARSE_MODEL=claude-opus-5
TRIALRAG_QUERY_PARSE_EFFORT=low
TRIALRAG_JUDGE_MODEL=claude-opus-5       # eval-only; judge != generator where feasible

# --- Voyage (embeddings + reranking) ---
VOYAGE_API_KEY=pa-...
TRIALRAG_EMBED_MODEL=voyage-4-lite
TRIALRAG_EMBED_DIM=512                   # Matryoshka truncation target
TRIALRAG_RERANK_MODEL=rerank-2.5-lite

# --- Retrieval tuning ---
TRIALRAG_DENSE_K=50
TRIALRAG_SPARSE_K=50
TRIALRAG_RRF_K=60
TRIALRAG_RERANK_TOP_N=8
TRIALRAG_MAX_CHUNKS_PER_STUDY=3
TRIALRAG_HNSW_EF_SEARCH=100

# --- Cost guardrails (a public LLM endpoint is a wallet-drain vector) ---
TRIALRAG_MAX_DAILY_SPEND_USD=1.50
TRIALRAG_PER_IP_DAILY_QUERIES=25
TRIALRAG_RATE_LIMIT_PER_MINUTE=6

# --- Object storage ---
TRIALRAG_S3_BUCKET=
AWS_REGION=us-east-1

# --- Observability ---
TRIALRAG_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Ingestion ---
TRIALRAG_CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
TRIALRAG_CTGOV_RATE_LIMIT_RPM=40         # safety margin under the ~50 rpm cap
